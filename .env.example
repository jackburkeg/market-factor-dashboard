# Copy to .env (never commit .env). Keys are optional; they are read from the environment
# and are never written to caches or exports.

# FRED: enables ALFRED vintages (true point-in-time history) for WTI. Free key:
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Financial Modeling Prep: optional historical statements (Canadian coverage unverified).
FMP_API_KEY=

# Optional: where Parquet snapshots are stored (default ./data_cache)
# MFD_CACHE_DIR=
